generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserRole {
  SHIPPER
  TRANSPORTER
  ADMIN
}

enum LoadStatus {
  POSTED
  ACCEPTED
  PICKED_UP
  IN_TRANSIT
  AWAITING_CONFIRMATION
  DELIVERED
  DISPUTED
  CANCELLED
  REFUND_PENDING
}

enum DocumentStatus {
  PENDING
  UNDER_REVIEW
  VERIFIED
  REJECTED
}

enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  BILL_OF_LADING
  CUSTOMS_DECLARATION
  OTHER
}

enum NotificationChannel {
  SMS
  IN_APP
  VOICE
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  CLOSED
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ─── Models ──────────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  loads         Load[]
  subscriptions Subscription[]
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  phone        String   @unique
  email        String?  @unique
  name         String
  passwordHash String
  role         UserRole
  isVerified   Boolean  @default(false)
  isActive     Boolean  @default(true)
  vehicleType  String?  // TRANSPORTER only
  numberPlate  String?  // TRANSPORTER only
  company      String?  // SHIPPER only
  rating       Float    @default(0)
  ratingCount  Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant             Tenant         @relation(fields: [tenantId], references: [id])
  otpRecords         OtpRecord[]
  shipperLoads       Load[]         @relation("ShipperLoads")
  transporterLoads   Load[]         @relation("TransporterLoads")
  notifications      Notification[]
  documents          Document[]
  airtimeLogs        AirtimeLog[]
  raisedDisputes     Dispute[]      @relation("DisputeRaisedBy")
  resolvedDisputes   Dispute[]      @relation("DisputeResolvedBy")

  @@index([tenantId])
  @@index([phone])
}

model OtpRecord {
  id        String   @id @default(cuid())
  userId    String
  phone     String
  otpHash   String
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([phone])
}

model Load {
  id            String     @id @default(cuid())
  shortId       String     @unique  // e.g. FF-2026-001 (used in USSD + SMS)
  tenantId      String
  shipperId     String
  transporterId String?
  status        LoadStatus @default(POSTED)

  // Load details
  origin        String
  destination   String
  cargoType     String
  weight        Float
  deliveryDate  DateTime
  notes         String?

  // Tracking
  lastLocation  String?    // USSD checkpoint fallback
  rating        Int?       // 1-5 stars from shipper
  ratingNote    String?

  // Timestamps
  acceptedAt    DateTime?
  pickedUpAt    DateTime?
  inTransitAt   DateTime?
  deliveredAt   DateTime?
  confirmedAt   DateTime?
  cancelledAt   DateTime?

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  tenant        Tenant          @relation(fields: [tenantId], references: [id])
  shipper       User            @relation("ShipperLoads", fields: [shipperId], references: [id])
  transporter   User?           @relation("TransporterLoads", fields: [transporterId], references: [id])
  statusLogs    LoadStatusLog[]
  notifications Notification[]
  documents     Document[]
  disputes      Dispute[]
  smsLogs       SmsLog[]

  @@index([tenantId])
  @@index([shipperId])
  @@index([transporterId])
  @@index([status])
}

model LoadStatusLog {
  id        String     @id @default(cuid())
  loadId    String
  status    LoadStatus
  channel   String     @default("WEB")  // WEB | USSD | SYSTEM
  changedBy String                       // userId or 'SYSTEM'
  note      String?
  createdAt DateTime   @default(now())

  load Load @relation(fields: [loadId], references: [id], onDelete: Cascade)

  @@index([loadId])
}

model Notification {
  id        String              @id @default(cuid())
  tenantId  String
  userId    String
  loadId    String?
  channel   NotificationChannel
  title     String
  body      String
  isRead    Boolean             @default(false)
  createdAt DateTime            @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  load Load? @relation(fields: [loadId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tenantId])
}

model SmsLog {
  id          String   @id @default(cuid())
  loadId      String?
  recipient   String
  message     String
  status      String   @default("QUEUED")  // QUEUED | SENT | DELIVERED | FAILED
  atMessageId String?
  retryCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  load Load? @relation(fields: [loadId], references: [id], onDelete: SetNull)

  @@index([loadId])
  @@index([recipient])
}

model AirtimeLog {
  id          String   @id @default(cuid())
  userId      String
  loadId      String?
  phone       String
  amount      Float
  currency    String   @default("KES")
  status      String   @default("PENDING")  // PENDING | SUCCESS | FAILED
  retryCount  Int      @default(0)
  atResponse  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Document {
  id          String         @id @default(cuid())
  tenantId    String
  userId      String
  loadId      String?
  type        DocumentType
  status      DocumentStatus @default(PENDING)
  fileUrl     String
  fileName    String
  fileSize    Int
  mimeType    String
  rejectNote  String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user User  @relation(fields: [userId], references: [id])
  load Load? @relation(fields: [loadId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([loadId])
}

model Dispute {
  id          String        @id @default(cuid())
  tenantId    String
  loadId      String
  raisedById  String
  resolvedById String?
  status      DisputeStatus @default(OPEN)
  description String
  resolution  String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  load       Load  @relation(fields: [loadId], references: [id])
  raisedBy   User  @relation("DisputeRaisedBy", fields: [raisedById], references: [id])
  resolvedBy User? @relation("DisputeResolvedBy", fields: [resolvedById], references: [id])

  @@index([tenantId])
  @@index([loadId])
}

model Subscription {
  id        String           @id @default(cuid())
  tenantId  String           @unique
  tier      SubscriptionTier @default(FREE)
  status    String           @default("ACTIVE")
  startDate DateTime         @default(now())
  endDate   DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
}
