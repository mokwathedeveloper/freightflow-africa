# ─── Africa's Talking ────────────────────────────────────────────────────────
AT_API_KEY=your_at_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=FreightFlow
AT_USSD_CODE=*384*7447#
AT_VOICE_NUMBER=+254XXXXXXXXX
AIRTIME_REWARD_AMOUNT=20

# ─── Database (Neon Serverless Postgres) ─────────────────────────────────────
# Create free DB at https://neon.tech — copy BOTH URLs from your project dashboard (they differ!)
# DATABASE_URL:  pooled connection endpoint (e.g. ep-xxx-pooler.region.aws.neon.tech) — used at runtime by Prisma Client
# DIRECT_URL:    direct (non-pooled) connection endpoint (e.g. ep-xxx.region.aws.neon.tech) — required by Prisma migrate/push
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/freightflow?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/freightflow?sslmode=require

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_minimum_32_chars_here_change_this
JWT_REFRESH_SECRET=your_jwt_refresh_secret_different_from_above
JWT_EXPIRES_IN=15m

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── M-Pesa (Safaricom Daraja) — Deferred to v2 ─────────────────────────────
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=174379
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://your-domain.com/api/webhooks/mpesa

# ─── Cloudinary (Document Uploads) — Deferred to v2 ─────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
