# ─── Africa's Talking ────────────────────────────────────────────────────────
AT_API_KEY=your_at_api_key_here
AT_USERNAME=sandbox
AT_SENDER_ID=FreightFlow
AT_USSD_CODE=*384*7447#
AT_VOICE_NUMBER=+254XXXXXXXXX
AIRTIME_REWARD_AMOUNT=20

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_USER=freightflow
POSTGRES_PASSWORD=your_strong_password_here
POSTGRES_DB=freightflow
DATABASE_URL=postgresql://freightflow:your_strong_password_here@localhost:5432/freightflow

# ─── JWT Authentication ──────────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_minimum_32_chars_here_change_this
JWT_REFRESH_SECRET=your_jwt_refresh_secret_different_from_above
JWT_EXPIRES_IN=15m

# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

